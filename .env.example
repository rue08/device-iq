# Copy this file to .env and fill in real values. .env is gitignored,
# this file is not - never put real secrets in .env.example.

# Local Postgres connection string. See PROJECT.md for how the dev
# database was created.
DATABASE_URL="postgresql://USER@localhost:5432/DATABASE_NAME?schema=public"

# On the OCI VM instead, Postgres runs as a Compose service named
# "postgres" on the same Docker network (see docker-compose.yml), which
# also reads POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below to create
# itself - keep these three in sync with the DATABASE_URL. The password
# must not contain @ : / # ? %:
# DATABASE_URL="postgresql://device_iq:PASSWORD@postgres:5432/device_iq?schema=public"
# POSTGRES_USER=device_iq
# POSTGRES_PASSWORD=
# POSTGRES_DB=device_iq

PORT=4000

# Required - Firebase Admin SDK credentials, server-side only.
# Get this from: Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key. Save the downloaded JSON file as
# backend/firebase-service-account.json (gitignored) and point this at it.
# Never commit that file, never ship it to the phone app or the laptop
# agent - see PROJECT.md 2b.
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Public key (not a secret) - Firebase Console -> Project Settings ->
# General tab -> "Web API Key". Not used by this backend directly yet -
# needed by the Phase 1b laptop agent (plain shell/PowerShell, no Firebase
# SDK) to exchange its createCustomToken result for a real ID token via
# the Identity Toolkit REST API's accounts:signInWithCustomToken endpoint.
# See PROJECT.md §2b.
FIREBASE_WEB_API_KEY=
