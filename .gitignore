# Dependencies
node_modules/

# Environment variables / secrets - never commit these
.env
.env.local
firebase-service-account.json

# macOS
.DS_Store

# Windows telemetry spike/probe output - generated by running
# agents-windows-poc/telemetry-probe.ps1 on the actual Windows machine,
# never meant to be committed.
agents-windows-poc/battery-report.*
agents-windows-poc/telemetry-windows.json

# READMEs kept on disk but not tracked in git, per request. The two under
# mobile/.dart_tool/ are already covered by the .dart_tool/ rule below;
# listed here anyway for a single place documenting all 5 known READMEs.
macos-agent/README.md
mobile/README.md
windows-agent/README.md
mobile/.dart_tool/extension_discovery/README.md
mobile/.dart_tool/chrome-device/Default/README

# Platform-specific ignores (Flutter app, macOS/Windows agents) get added
# here once those directories actually exist - not guessed ahead of time.
PROJECT.md

# --- mobile/ (Flutter app) ---
# Merged in from mobile/.gitignore + mobile/android/.gitignore so the repo
# has a single .gitignore. Patterns that were anchored (leading "/") to
# those files' own directory are re-prefixed with mobile/ or mobile/android/
# so they still match the same paths; unanchored patterns are unchanged
# since they already match at any depth.
*.class
*.log
*.pyc
*.swp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
# .vscode/ intentionally not ignored - launch configs/tasks may be worth
# sharing (same default flutter create leaves this commented out)
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
mobile/build/
mobile/coverage/
app.*.symbols
app.*.map.json
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release

# mobile/android/ (Gradle project)
gradle-wrapper.jar
mobile/android/.gradle
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat
mobile/android/local.properties
GeneratedPluginRegistrant.java
.cxx/
key.properties
**/*.keystore
**/*.jks

# IDE (also applies repo-wide, not just mobile/)
*.iml
*.ipr
*.iws
.idea/